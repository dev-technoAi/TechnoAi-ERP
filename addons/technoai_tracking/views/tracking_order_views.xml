<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tracking_order_view_list" model="ir.ui.view">
        <field name="name">technoai.tracking.order.list</field>
        <field name="model">technoai.tracking.order</field>
        <field name="arch" type="xml">
            <list string="Tracked orders" decoration-danger="is_overdue" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="po_date"/>
                <field name="line_count"/>
                <field name="progress" widget="progressbar"/>
                <field name="next_eta"/>
                <field name="overall_eta" optional="hide"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" column_invisible="1"/>
                <field name="status_summary" widget="badge" decoration-danger="status_summary == 'late'"
                       decoration-success="status_summary in ('delivered', 'closed')" decoration-warning="status_summary == 'in_transit'"
                       decoration-info="status_summary in ('ready_to_ship', 'in_inventory', 'ready_for_delivery')"/>
            </list>
        </field>
    </record>

    <record id="tracking_order_view_search" model="ir.ui.view">
        <field name="name">technoai.tracking.order.search</field>
        <field name="model">technoai.tracking.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Client PO or SO" filter_domain="['|', ('name', 'ilike', self), ('sale_order_id.name', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="line_ids" string="Item" filter_domain="[('line_ids.name', 'ilike', self)]"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="late" string="Late" domain="[('is_overdue', '=', True)]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="mine" string="My orders" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_client" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_user" string="Sales person" context="{'group_by': 'user_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status_summary'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="tracking_order_view_form" model="ir.ui.view">
        <field name="name">technoai.tracking.order.form</field>
        <field name="model">technoai.tracking.order</field>
        <field name="arch" type="xml">
            <form string="Tracked order">
                <header>
                    <button name="action_open_public_page" string="Open tracking page" type="object" class="btn-primary" icon="fa-external-link"/>
                    <button name="action_sync_lines" string="Update items from the Sales Order" type="object" icon="fa-refresh"
                            invisible="not sale_order_id" groups="technoai_tracking.group_tracking_data_entry"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale_order" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not sale_order_id">
                            <div class="o_stat_info"><span class="o_stat_text">Sales Order</span><field name="sale_order_id" class="o_stat_value" readonly="1"/></div>
                        </button>
                        <button name="action_open_purchases" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not purchase_count">
                            <field name="purchase_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                        <button name="action_open_pickings" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_count">
                            <field name="picking_count" widget="statinfo" string="Transfers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Client PO number"/></h1>
                        <field name="status_summary" widget="badge" decoration-danger="status_summary == 'late'" decoration-success="status_summary in ('delivered', 'closed')"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="contact_name"/>
                            <field name="contact_email" widget="email"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="po_date"/>
                            <field name="payment_terms"/>
                            <field name="overall_eta"/>
                            <field name="eta_override"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="public_url" widget="url" string="Tracking link"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="line_ids">
                                <list editable="bottom" decoration-danger="is_late" decoration-muted="status == 'delivered'">
                                    <field name="line_number"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom" optional="hide"/>
                                    <field name="supplier_id" optional="show"/>
                                    <field name="status"/>
                                    <field name="eta"/>
                                    <field name="is_late" column_invisible="1"/>
                                    <field name="shipment_link" widget="url" optional="show"/>
                                    <field name="auto_note" optional="show"/>
                                    <field name="last_update" optional="hide"/>
                                    <field name="internal_remarks" optional="hide"/>
                                    <field name="unit_price" optional="hide" groups="sales_team.group_sale_manager"/>
                                </list>
                            </field>
                            <div class="text-muted small">Receipts move items to In Inventory, reserved deliveries to Ready for Delivery and
                                done deliveries to Delivered on their own. Ready to Ship and In Transit, the ETA and the shipment link are set here.</div>
                        </page>
                        <page string="Client updates" name="subscribers">
                            <field name="subscriber_ids">
                                <list editable="bottom">
                                    <field name="email"/>
                                    <field name="confirmed"/>
                                </list>
                            </field>
                            <div class="text-muted small">These addresses get an email on every status change and when the order is complete.
                                Clients add themselves from the tracking page and confirm by email.</div>
                        </page>
                        <page string="Internal notes" name="notes">
                            <field name="subject" placeholder="Subject"/>
                            <field name="internal_notes" placeholder="Never shown to the client"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="tracking_order_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">technoai.tracking.order</field>
        <field name="view_mode">list,form</field>
        <field name="path">order-tracking</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tracked orders yet</p>
            <p>Confirm a Sales Order: its tracking is created on its own, with the client's PO number.</p>
        </field>
    </record>

    <record id="tracking_dashboard_action" model="ir.actions.client">
        <field name="name">Order Tracking</field>
        <field name="tag">technoai_tracking_dashboard</field>
        <field name="path">tracking</field>
    </record>
</odoo>

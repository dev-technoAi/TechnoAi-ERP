<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tracking_line_view_list" model="ir.ui.view">
        <field name="name">technoai.tracking.line.list</field>
        <field name="model">technoai.tracking.line</field>
        <field name="arch" type="xml">
            <list string="Items" editable="bottom" create="0" decoration-danger="is_late">
                <field name="order_id" readonly="1"/>
                <field name="line_number" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="quantity" readonly="1"/>
                <field name="supplier_id"/>
                <field name="status"/>
                <field name="eta"/>
                <field name="is_late" column_invisible="1"/>
                <field name="shipment_link" widget="url"/>
                <field name="auto_note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="tracking_line_view_search" model="ir.ui.view">
        <field name="name">technoai.tracking.line.search</field>
        <field name="model">technoai.tracking.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="order_id"/>
                <field name="supplier_id"/>
                <filter name="not_delivered" string="Not delivered" domain="[('status', '!=', 'delivered')]"/>
                <filter name="late" string="Late" domain="[('status', '!=', 'delivered'), ('eta', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="tracking_line_view_pivot" model="ir.ui.view">
        <field name="name">technoai.tracking.line.pivot</field>
        <field name="model">technoai.tracking.line</field>
        <field name="arch" type="xml">
            <pivot string="Items">
                <field name="supplier_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="tracking_line_late_action" model="ir.actions.act_window">
        <field name="name">Late items</field>
        <field name="res_model">technoai.tracking.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_late': 1}</field>
    </record>

    <record id="tracking_line_report_action" model="ir.actions.act_window">
        <field name="name">Items report</field>
        <field name="res_model">technoai.tracking.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_not_delivered': 1}</field>
    </record>

    <record id="tracking_subscriber_action" model="ir.actions.act_window">
        <field name="name">Client subscribers</field>
        <field name="res_model">technoai.tracking.subscriber</field>
        <field name="view_mode">list</field>
    </record>
    <record id="tracking_subscriber_view_list" model="ir.ui.view">
        <field name="name">technoai.tracking.subscriber.list</field>
        <field name="model">technoai.tracking.subscriber</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="order_id"/>
                <field name="email"/>
                <field name="confirmed"/>
            </list>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_tracking" model="ir.ui.view">
        <field name="name">sale.order.form.technoai.tracking</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_tracking" type="object" class="oe_stat_button" icon="fa-map-marker" invisible="state != 'sale'"
                        groups="technoai_tracking.group_tracking_viewer">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Tracking</span>
                        <field name="tracking_label" class="o_stat_value" readonly="1"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Launcher top bar: badge on the left; Edit Apps, Close and the systray on the right -->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_techno_home_menu')]/div[1]" position="replace">
            <div class="o_tai_home_bar">
                <div class="o_tai_home_badge">
                    <span class="o_dot"/>
                    <span class="o_domain">technoai.ae</span>
                    <span class="badge rounded-pill">Enterprise Apps</span>
                </div>
                <div class="o_tai_home_actions">
                    <t t-if="!state.isEditingApps">
                        <button class="btn o_tai_home_btn o_accent" title="Customize apps layout and order" t-on-click="() => this.toggleEditApps(true)">
                            <i class="fa fa-pencil"/><span>Edit Apps</span>
                        </button>
                    </t>
                    <t t-else="">
                        <button class="btn o_tai_home_btn o_done" t-on-click="() => this.toggleEditApps(false)">
                            <i class="fa fa-check"/><span>Done</span>
                        </button>
                        <button class="btn o_tai_home_btn" title="Reset to default order" t-on-click="() => this.resetAppsOrder()">
                            <i class="fa fa-undo"/><span>Reset</span>
                        </button>
                    </t>
                    <button class="btn o_tai_home_btn" t-on-click="() => this.toggleHomeMenu(false)">
                        <i class="oi oi-close"/><span>Close</span>
                    </button>
                    <span class="o_tai_home_sep"/>
                    <div class="o_tai_home_systray d-flex align-items-center" role="menu">
                        <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                            <div t-att-data-index="item.index"/>
                            <ErrorHandler onError="error => this.handleItemError(error, item)">
                                <t t-component="item.Component" t-props="item.props"/>
                            </ErrorHandler>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.SwitchCompanyMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_switch_company_menu')]" position="attributes">
            <attribute name="t-if">!isSingleCompany or !canEditCompany</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_switch_company_menu')]" position="after">
            <div t-if="isSingleCompany and canEditCompany" class="o_switch_company_menu d-none d-md-block">
                <button class="o-dropdown dropdown-toggle o-no-caret" t-att-title="companyService.currentCompany.name + ' settings'" t-on-click="openCompany">
                    <i class="fa fa-building d-lg-none"/>
                    <span class="oe_topbar_name d-none d-lg-block text-truncate" t-esc="companyService.currentCompany.name"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>

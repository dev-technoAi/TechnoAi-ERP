<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Everyone only ever sees their own conversations, administrators included -->
    <record id="rule_technoai_ai_chat_own" model="ir.rule">
        <field name="name">AI chats: own chats only</field>
        <field name="model_id" ref="model_technoai_ai_chat"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_check_mailboxes" model="ir.cron">
            <field name="name">RFQ Mail Notification: check mailboxes</field>
            <field name="model_id" ref="model_rfq_notify_mailbox"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_mailboxes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_remind" model="ir.cron">
            <field name="name">RFQ Mail Notification: remind unopened alerts</field>
            <field name="model_id" ref="model_rfq_notify_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

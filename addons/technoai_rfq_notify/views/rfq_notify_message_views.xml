<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rfq_notify_message_view_list" model="ir.ui.view">
        <field name="name">rfq.notify.message.list</field>
        <field name="model">rfq.notify.message</field>
        <field name="arch" type="xml">
            <list string="RFQ Alerts" create="0" decoration-bf="not opened_date" default_order="date desc">
                <field name="date"/>
                <field name="kind" widget="badge" decoration-info="kind == 'rfq'" decoration-primary="kind == 'client'" decoration-muted="kind == 'sent'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="mailbox_email" optional="show"/>
                <field name="email_from"/>
                <field name="subject"/>
                <field name="browser_state" widget="badge" decoration-success="browser_state == 'sent'" optional="show"/>
                <field name="whatsapp_state" widget="badge" decoration-success="whatsapp_state == 'sent'" decoration-danger="whatsapp_state == 'failed'"/>
                <field name="whatsapp_info" optional="hide"/>
                <field name="opened_date" string="Opened"/>
                <field name="taskhub_rfq_id"/>
            </list>
        </field>
    </record>

    <record id="rfq_notify_message_view_search" model="ir.ui.view">
        <field name="name">rfq.notify.message.search</field>
        <field name="model">rfq.notify.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject"/>
                <field name="email_from"/>
                <field name="client_key" string="Client"/>
                <field name="user_id"/>
                <filter name="mine" string="My alerts" domain="[('user_id', '=', uid)]"/>
                <filter name="received" string="Received" domain="[('direction', '=', 'in')]"/>
                <filter name="unopened" string="Not opened yet" domain="[('opened_date', '=', False), ('direction', '=', 'in')]"/>
                <separator/>
                <filter name="rfq" string="New RFQs" domain="[('kind', '=', 'rfq')]"/>
                <filter name="client" string="Client emails" domain="[('kind', '=', 'client')]"/>
                <filter name="sent" string="Sent from the ERP" domain="[('kind', '=', 'sent')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="whatsapp_failed" string="WhatsApp failed" domain="[('whatsapp_state', '=', 'failed')]"/>
                <group>
                    <filter name="group_user" string="Employee" context="{'group_by': 'user_id'}"/>
                    <filter name="group_client" string="Client" context="{'group_by': 'client_key'}"/>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rfq_notify_message_view_form" model="ir.ui.view">
        <field name="name">rfq.notify.message.form</field>
        <field name="model">rfq.notify.message</field>
        <field name="arch" type="xml">
            <form string="Email" create="0">
                <header>
                    <button name="action_reply" string="Reply" type="object" class="btn-primary" icon="fa-reply"/>
                    <button name="action_reply_all" string="Reply all" type="object" icon="fa-reply-all"/>
                    <button name="action_forward" string="Forward" type="object" icon="fa-share"/>
                    <button name="action_open_quotation" string="Open Draft Quotation" type="object" icon="fa-file-text-o" invisible="not taskhub_rfq_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_taskhub_rfq" type="object" class="oe_stat_button" icon="fa-inbox" invisible="not taskhub_rfq_id">
                            <div class="o_stat_info"><span class="o_stat_text">Task Hub</span><field name="taskhub_rfq_id" class="o_stat_value" readonly="1"/></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <field name="kind" widget="badge" decoration-info="kind == 'rfq'" decoration-primary="kind == 'client'" readonly="1"/>
                        <h1><field name="subject" readonly="1"/></h1>
                        <div class="text-muted">
                            Mailbox <field name="mailbox_email" class="oe_inline"/> &#183;
                            <field name="conversation_count" class="oe_inline"/> email(s) in this conversation &#183;
                            client <field name="client_name" class="oe_inline"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-8">
                            <field name="conversation_html" nolabel="1" readonly="1" class="o_rfqn_conversation"/>
                        </div>
                        <div class="col-lg-4">
                            <div class="o_rfqn_side">
                                <h5>All emails from this client</h5>
                                <div class="text-muted small mb-2">Everything this client sent to <field name="mailbox_email" class="oe_inline"/> besides this conversation.</div>
                                <field name="client_message_ids" nolabel="1" readonly="1">
                                    <list no_open="1" create="0" delete="0">
                                        <field name="subject"/>
                                        <field name="date" widget="date"/>
                                        <field name="opened_date" column_invisible="1"/>
                                        <button name="action_open" type="object" icon="fa-envelope-open-o" title="Open"/>
                                    </list>
                                </field>
                                <h5 class="mt-3">Alert</h5>
                                <group class="mt-0">
                                    <field name="date"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="browser_state"/>
                                    <field name="whatsapp_state"/>
                                    <field name="whatsapp_info" invisible="not whatsapp_info"/>
                                    <field name="opened_date"/>
                                </group>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rfq_notify_message_action" model="ir.actions.act_window">
        <field name="name">RFQ Alerts</field>
        <field name="res_model">rfq.notify.message</field>
        <field name="view_mode">list,form</field>
        <field name="path">rfq-alerts</field>
        <field name="context">{'search_default_received': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No RFQ alerts yet</p>
            <p>Add your mailbox under My Mailboxes; RFQs that reach it show up here, and you are alerted at once.</p>
        </field>
    </record>
</odoo>

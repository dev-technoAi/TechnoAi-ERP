<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_taskhub_quotation" model="ir.actions.report">
        <field name="name">Quotation</field>
        <field name="model">taskhub.quotation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">technoai_taskhub.report_taskhub_quotation</field>
        <field name="report_file">technoai_taskhub.report_taskhub_quotation</field>
        <field name="print_report_name">'Quotation - %s' % object.name</field>
        <field name="binding_model_id" ref="model_taskhub_quotation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_taskhub_quotation_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>
            <t t-set="address">
                <strong t-esc="o.partner_id.name or o.client_name"/>
                <div t-if="o.partner_id" t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'phone'], 'no_marker': True}"/>
                <div t-if="o.client_email" t-esc="o.client_email"/>
            </t>
            <div class="page">
                <h2 class="mt-4">Quotation <span t-field="o.name"/></h2>
                <div class="row mt-3 mb-4">
                    <div class="col-3"><strong>Date</strong><div t-field="o.date"/></div>
                    <div class="col-3"><strong>Valid until</strong><div t-field="o.valid_until"/></div>
                    <div class="col-3" t-if="o.rfq_id"><strong>Your request</strong><div t-field="o.rfq_id.subject"/></div>
                    <div class="col-3"><strong>Prepared by</strong><div t-field="o.user_id"/></div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Quantity</th>
                            <th>Unit</th>
                            <th class="text-end">Unit price</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td><span t-field="line.name"/></td>
                            <td class="text-end" t-esc="'%g' % line.quantity"/>
                            <td><span t-field="line.uom"/></td>
                            <td class="text-end"><span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                            <td class="text-end"><span t-field="line.subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                        </tr>
                    </tbody>
                </table>
                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr><td>Untaxed</td><td class="text-end"><span t-field="o.amount_untaxed"/></td></tr>
                            <tr><td>VAT <t t-esc="'%g' % o.vat_rate"/>%</td><td class="text-end"><span t-field="o.amount_tax"/></td></tr>
                            <tr class="fw-bold"><td>Total</td><td class="text-end"><span t-field="o.amount_total"/></td></tr>
                        </table>
                    </div>
                </div>
                <div t-if="o.notes" class="mt-3" t-field="o.notes"/>
            </div>
        </t>
    </template>

    <template id="report_taskhub_quotation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="technoai_taskhub.report_taskhub_quotation_document"/>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.taskhub</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Task Hub" string="Task Hub" name="technoai_taskhub" groups="base.group_system">
                    <block title="RFQ mailbox" name="taskhub_rfq_mailbox">
                        <setting string="Read RFQ emails from a mailbox"
                                 help="Every 10 minutes, quotation requests in this inbox become Email RFQs. The inbox is only read: nothing is marked as read, moved or deleted, and newsletters, OTPs and other non-RFQ emails are ignored.">
                            <field name="taskhub_rfq_mailbox"/>
                            <div class="content-group" invisible="not taskhub_rfq_mailbox">
                                <div class="row mt8"><label for="taskhub_imap_host" class="col-lg-4 o_light_label"/><field name="taskhub_imap_host"/></div>
                                <div class="row"><label for="taskhub_imap_port" class="col-lg-4 o_light_label"/><field name="taskhub_imap_port"/></div>
                                <div class="row"><label for="taskhub_imap_user" class="col-lg-4 o_light_label"/><field name="taskhub_imap_user"/></div>
                                <div class="row"><label for="taskhub_imap_password" class="col-lg-4 o_light_label"/><field name="taskhub_imap_password" password="True"/></div>
                                <button name="action_taskhub_test_mailbox" type="object" string="Test connection" icon="fa-plug" class="btn-link mt8"/>
                            </div>
                        </setting>
                    </block>
                    <block title="WhatsApp dispatch" name="taskhub_whatsapp">
                        <setting string="Provider" help="How the RFQ alerts and Dispatch send WhatsApp messages. Without an account, WhatsApp opens with the message ready to send.">
                            <field name="taskhub_whatsapp_provider" widget="radio"/>
                            <field name="taskhub_wa_saved_provider" invisible="1"/>
                            <div class="alert alert-warning small mt8 mb-0 py-2" role="alert"
                                 invisible="taskhub_whatsapp_provider == taskhub_wa_saved_provider">
                                <i class="fa fa-exclamation-triangle me-1"/>
                                Press <b>Save</b> at the top: until then the WhatsApp alerts keep using the old choice.
                            </div>
                            <div class="text-muted small mt8" invisible="taskhub_whatsapp_provider != 'bot'">
                                Free. The bot runs on the Techno AI server with one company number; it only sends alerts and does not read or answer chats on that number.
                            </div>
                        </setting>
                        <setting string="WhatsApp number" invisible="taskhub_whatsapp_provider != 'bot'"
                                 help="Use a company number, not the Meta / Chatwoot number or a personal one.">
                            <div class="content-group o_taskhub_wa_bot">
                                <div class="d-flex align-items-center gap-2 mt8">
                                    <field name="taskhub_wa_bot_state" widget="badge" nolabel="1"
                                           decoration-success="taskhub_wa_bot_state == 'connected'"
                                           decoration-warning="taskhub_wa_bot_state in ('qr', 'starting', 'idle', 'reconnecting')"
                                           decoration-danger="taskhub_wa_bot_state in ('logged_out', 'error', 'offline')"/>
                                    <button name="action_taskhub_wa_bot_refresh" type="object" string="Refresh" icon="fa-refresh" class="btn-link p-0"/>
                                </div>
                                <div invisible="taskhub_wa_bot_state != 'qr'" class="d-flex gap-3 mt-2">
                                    <field name="taskhub_wa_bot_qr" widget="image" nolabel="1" readonly="1" options="{'size': [168, 168]}"/>
                                    <ol class="ps-3 mb-0 small">
                                        <li>Open WhatsApp on the company phone</li>
                                        <li>Tap <b>⋮</b> → <b>Linked devices</b></li>
                                        <li>Tap <b>Link a device</b></li>
                                        <li>Scan this code</li>
                                    </ol>
                                </div>
                                <div invisible="taskhub_wa_bot_state != 'qr'" class="text-muted small mt-1">
                                    The code changes every 20 seconds; press Refresh if it stops working.
                                </div>
                                <div invisible="taskhub_wa_bot_state != 'connected'" class="mt-2">
                                    <div class="row"><span class="col-lg-4 o_light_label">Number</span><field name="taskhub_wa_bot_number" class="col-lg-8"/></div>
                                    <div class="row"><span class="col-lg-4 o_light_label">Connected since</span><field name="taskhub_wa_bot_since" class="col-lg-8"/></div>
                                    <div class="row"><span class="col-lg-4 o_light_label">Alerts today</span><field name="taskhub_wa_bot_today" class="col-lg-8"/></div>
                                    <div class="d-flex gap-2 mt-2">
                                        <button name="action_taskhub_wa_bot_test" type="object" string="Send a test to me" icon="fa-paper-plane" class="btn-secondary btn-sm"/>
                                        <button name="action_taskhub_wa_bot_unlink" type="object" string="Unlink number" icon="fa-sign-out" class="btn-secondary btn-sm text-danger"
                                                confirm="Unlink the company WhatsApp number? WhatsApp alerts stop until the QR code is scanned again."/>
                                    </div>
                                </div>
                                <div invisible="taskhub_wa_bot_state == 'connected' or not taskhub_wa_bot_error" class="text-danger small mt-1">
                                    <field name="taskhub_wa_bot_error" nolabel="1"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="WhatsApp Cloud API" invisible="taskhub_whatsapp_provider != 'cloud'"
                                 help="Meta business account. Free-form messages reach people who wrote to you in the last 24 hours.">
                            <div class="content-group">
                                <div class="row mt8"><label for="taskhub_wa_cloud_token" class="col-lg-4 o_light_label"/><field name="taskhub_wa_cloud_token" password="True"/></div>
                                <div class="row"><label for="taskhub_wa_cloud_phone_id" class="col-lg-4 o_light_label"/><field name="taskhub_wa_cloud_phone_id"/></div>
                            </div>
                        </setting>
                        <setting string="Twilio" invisible="taskhub_whatsapp_provider != 'twilio'">
                            <div class="content-group">
                                <div class="row mt8"><label for="taskhub_wa_twilio_sid" class="col-lg-4 o_light_label"/><field name="taskhub_wa_twilio_sid"/></div>
                                <div class="row"><label for="taskhub_wa_twilio_token" class="col-lg-4 o_light_label"/><field name="taskhub_wa_twilio_token" password="True"/></div>
                                <div class="row"><label for="taskhub_wa_twilio_from" class="col-lg-4 o_light_label"/><field name="taskhub_wa_twilio_from" placeholder="+14155238886"/></div>
                            </div>
                        </setting>
                        <setting string="Green API" invisible="taskhub_whatsapp_provider != 'green'">
                            <div class="content-group">
                                <div class="row mt8"><label for="taskhub_wa_green_instance" class="col-lg-4 o_light_label"/><field name="taskhub_wa_green_instance"/></div>
                                <div class="row"><label for="taskhub_wa_green_token" class="col-lg-4 o_light_label"/><field name="taskhub_wa_green_token" password="True"/></div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="taskhub_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'technoai_taskhub', 'bin_size': False}</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="taskhub_quotation_view_form" model="ir.ui.view">
        <field name="name">taskhub.quotation.form</field>
        <field name="model">taskhub.quotation</field>
        <field name="arch" type="xml">
            <form string="Draft Quotation">
                <header>
                    <button name="action_send_email" string="Email to client &amp; mark Quoted" type="object" class="btn-primary"/>
                    <button name="action_print_pdf" string="PDF" type="object" icon="fa-file-pdf-o"/>
                    <button name="action_download_excel" string="Excel" type="object" icon="fa-file-excel-o"/>
                    <button name="action_create_sale_order" string="Create quotation in Sales" type="object" icon="fa-share"
                            invisible="sale_order_id"/>
                    <button name="action_create_purchase_orders" string="Create Purchase Orders" type="object" icon="fa-shopping-cart"/>
                    <button name="action_new_revision" string="New revision" type="object" icon="fa-files-o"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_sale_order" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not sale_order_id">
                            <div class="o_stat_info"><span class="o_stat_text">Sales</span><field name="sale_order_id" class="o_stat_value" readonly="1"/></div>
                        </button>
                        <button name="action_open_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not purchase_count">
                            <field name="purchase_count" widget="statinfo" string="Purchase Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="rfq_id"/>
                            <field name="revision_of_id" invisible="not revision_of_id"/>
                            <field name="partner_id"/>
                            <field name="client_name"/>
                            <field name="client_email" widget="email"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="valid_until"/>
                            <field name="vat_rate"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="known_count" column_invisible="1"/>
                            <field name="known_summary" width="170px" decoration-success="known_count" decoration-muted="not known_count" decoration-bf="known_count"/>
                            <button name="action_show_known_suppliers" type="object" icon="fa-list-ul" title="Show the known suppliers of this item" invisible="not known_count"/>
                            <button name="action_search_online" type="object" icon="fa-globe" title="Search online for suppliers of this item (AI with Google Search)"/>
                            <field name="supplier_id" context="{'default_taskhub_is_supplier': True}"/>
                            <field name="source_url" widget="url" optional="show"/>
                            <field name="quantity"/>
                            <field name="uom"/>
                            <field name="cost"/>
                            <field name="price_unit"/>
                            <field name="subtotal"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <!-- Suppliers we already have a price from; online search stays separate from these records -->
                    <field name="known_current_line_id" invisible="1"/>
                    <field name="known_best_id" invisible="1"/>
                    <field name="known_selected_id" invisible="1"/>
                    <div class="mt-3" invisible="not known_current_line_id">
                        <h5 class="mb-1">Already available from our suppliers</h5>
                        <div class="text-muted small mb-2">For <field name="known_item_name" class="oe_inline fw-bold" nolabel="1"/>, best price first. From your own records only.</div>
                        <field name="known_source_ids" nolabel="1">
                            <list create="0" delete="0" no_open="1" decoration-success="parent.known_best_id == id" decoration-bf="parent.known_best_id == id">
                                <field name="currency_id" column_invisible="1"/>
                                <field name="supplier_id" string="Supplier"/>
                                <field name="name" string="Product"/>
                                <field name="unit_cost" widget="monetary"/>
                                <field name="write_date" string="Last price" widget="datetime" options="{'show_time': false}"/>
                                <field name="status" widget="badge" decoration-success="status == 'confirmed'" decoration-info="status == 'quoted'"/>
                                <field name="best_label" widget="badge" decoration-success="1" invisible="parent.known_best_id != id"/>
                                <field name="old_label" widget="badge" decoration-warning="1" invisible="not old_label"/>
                                <button name="action_use_for_line" type="object" string="Use this" class="btn-secondary btn-sm" invisible="parent.known_selected_id == id or parent.state != 'draft'" context="{'taskhub_line_id': parent.known_current_line_id}"/>
                                <button name="action_use_for_line" type="object" string="Selected" class="btn-primary btn-sm" invisible="parent.known_selected_id != id or parent.state != 'draft'" context="{'taskhub_line_id': parent.known_current_line_id}"/>
                            </list>
                        </field>
                    </div>
                    <!-- found on the internet by the AI search: separate from the records until saved -->
                    <div class="mt-3 p-3 border rounded" style="border-color: #c9b8f0 !important; background: #faf7ff;" invisible="not online_result_ids">
                        <h5 class="mb-1"><i class="fa fa-globe me-1"/>Online search (AI) for <field name="online_item_name" class="oe_inline" nolabel="1"/></h5>
                        <div class="small mb-2" style="color: #7a5cc4;">Found on the internet with Google Search. Not from your records: check the price, stock and link with the supplier before using.</div>
                        <field name="online_result_ids" nolabel="1">
                            <list create="0" no_open="1" delete="1">
                                <field name="supplier_name"/>
                                <field name="product_name"/>
                                <field name="price"/>
                                <field name="currency_code" string=""/>
                                <field name="url" widget="url"/>
                                <button name="action_save_to_suppliers" type="object" string="Save to my suppliers" class="btn-secondary btn-sm" invisible="sourcing_id"/>
                                <field name="sourcing_id" string="Saved" readonly="1" widget="many2one" options="{'no_open': True}"/>
                            </list>
                        </field>
                    </div>
                    <group>
                        <group>
                            <field name="notes" nolabel="1" colspan="2" placeholder="Terms, delivery, warranty..."/>
                        </group>
                        <group class="oe_subtotal_footer">
                            <field name="amount_untaxed"/>
                            <field name="amount_tax"/>
                            <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            <field name="amount_cost"/>
                            <field name="margin_percent" string="Margin %"/>
                        </group>
                    </group>
                    <notebook invisible="not rfq_email_body">
                        <page string="Client email" name="client_email">
                            <div class="text-muted small mb-2">
                                From <field name="rfq_email_from" class="oe_inline" readonly="1"/>,
                                received <field name="rfq_date_received" class="oe_inline" readonly="1"/>.
                                The items above were taken from this email of <field name="rfq_id" class="oe_inline" readonly="1"/>.
                            </div>
                            <field name="rfq_email_body" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="taskhub_quotation_view_list" model="ir.ui.view">
        <field name="name">taskhub.quotation.list</field>
        <field name="model">taskhub.quotation</field>
        <field name="arch" type="xml">
            <list string="Draft Quotations">
                <field name="name"/>
                <field name="rfq_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="valid_until"/>
                <field name="amount_total" sum="Total"/>
                <field name="margin_percent" string="Margin %"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="taskhub_quotation_action" model="ir.actions.act_window">
        <field name="name">Draft Quotations</field>
        <field name="res_model">taskhub.quotation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="taskhub_rfq_view_form" model="ir.ui.view">
        <field name="name">taskhub.rfq.form</field>
        <field name="model">taskhub.rfq</field>
        <field name="arch" type="xml">
            <form string="Email RFQ">
                <header>
                    <button name="action_approve" string="Approve &amp; create task" type="object" class="btn-primary"
                            invisible="state != 'new'" groups="technoai_taskhub.group_taskhub_admin"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'new'"
                            groups="technoai_taskhub.group_taskhub_admin"/>
                    <button name="action_new_quotation" string="Draft Quotation" type="object" class="btn-primary"
                            invisible="state not in ('approved', 'quoted', 'negotiating')"/>
                    <button name="action_negotiating" string="Negotiating" type="object" invisible="state != 'quoted'"/>
                    <button name="action_won" string="Won" type="object" class="btn-success" invisible="state not in ('quoted', 'negotiating')"/>
                    <button name="action_lost" string="Lost" type="object" invisible="state not in ('approved', 'quoted', 'negotiating')"/>
                    <button name="action_open_sourcing" string="Sourcing" type="object" icon="fa-search" invisible="not line_ids"/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="state not in ('won', 'lost', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,approved,quoted,negotiating,won"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_quotations" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not quotation_count">
                            <field name="quotation_count" widget="statinfo" string="Quotations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Won" bg_color="text-bg-success" invisible="state != 'won'"/>
                    <widget name="web_ribbon" title="Lost" bg_color="text-bg-danger" invisible="state != 'lost'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-secondary" invisible="state != 'rejected'"/>
                    <div class="oe_title">
                        <label for="subject"/>
                        <h1><field name="subject" placeholder="e.g. Rugged laptops + docks"/></h1>
                        <field name="name" readonly="1" class="text-muted"/>
                    </div>
                    <group>
                        <group string="Client">
                            <field name="partner_id"/>
                            <field name="client_name"/>
                            <field name="client_email" widget="email"/>
                            <field name="client_phone" widget="phone"/>
                        </group>
                        <group string="Handling">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="department_id"/>
                            <field name="date_received"/>
                            <field name="task_id"/>
                            <field name="amount" invisible="state in ('new', 'rejected')"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Requested items" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="uom"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Email" name="email">
                            <field name="email_body" readonly="source == 'email'"/>
                            <field name="source" invisible="1"/>
                        </page>
                        <page string="Outcome" name="outcome">
                            <group>
                                <field name="date_quoted"/>
                                <field name="reason" placeholder="Why it was won, lost or rejected"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="taskhub_rfq_view_list" model="ir.ui.view">
        <field name="name">taskhub.rfq.list</field>
        <field name="model">taskhub.rfq</field>
        <field name="arch" type="xml">
            <list string="Email RFQs">
                <header>
                    <button name="action_fetch_emails" type="object" string="Fetch Emails" class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="partner_id" string="Client"/>
                <field name="subject"/>
                <field name="date_received" string="Received"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="amount" sum="Total" decoration-info="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="message_attachment_count" string="Files" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'" decoration-success="state in ('approved', 'won')"
                       decoration-warning="state in ('quoted', 'negotiating')" decoration-danger="state in ('lost', 'rejected')"/>
            </list>
        </field>
    </record>

    <record id="taskhub_rfq_view_kanban" model="ir.ui.view">
        <field name="name">taskhub.rfq.kanban</field>
        <field name="model">taskhub.rfq</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="state"/>
                <field name="currency_id"/>
                <progressbar field="state" colors='{"won": "success", "lost": "danger"}' sum_field="amount"/>
                <templates>
                    <t t-name="card">
                        <field name="subject" class="fw-bold"/>
                        <div class="text-muted small"><field name="name"/> · <field name="partner_id"/></div>
                        <field name="amount" widget="monetary" invisible="not amount"/>
                        <footer>
                            <field name="date_received" widget="date" class="small text-muted"/>
                            <field name="activity_ids" widget="kanban_activity" class="ms-2"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="taskhub_rfq_view_search" model="ir.ui.view">
        <field name="name">taskhub.rfq.search</field>
        <field name="model">taskhub.rfq</field>
        <field name="arch" type="xml">
            <search string="Email RFQs">
                <field name="subject"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="client_email"/>
                <field name="line_ids" string="Item"/>
                <filter name="open" string="Open" domain="[('is_open', '=', True)]"/>
                <filter name="state_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="state_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="state_quoted" string="Quote sent" domain="[('state', '=', 'quoted')]"/>
                <filter name="state_negotiating" string="Negotiating" domain="[('state', '=', 'negotiating')]"/>
                <filter name="state_won" string="Won" domain="[('state', '=', 'won')]"/>
                <filter name="state_lost" string="Lost / Rejected" domain="[('state', 'in', ('lost', 'rejected'))]"/>
                <separator/>
                <filter name="mine" string="Assigned to me" domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Assigned to" context="{'group_by': 'user_id'}"/>
                    <filter name="group_partner" string="Client" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="taskhub_rfq_action" model="ir.actions.act_window">
        <field name="name">Email RFQs</field>
        <field name="res_model">taskhub.rfq</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No open RFQs</p>
            <p>Quotation requests from client emails show up here. You can also add one by hand.</p>
        </field>
    </record>

    <record id="taskhub_rfq_inbox_action" model="ir.actions.act_window">
        <field name="name">RFQ Inbox</field>
        <field name="res_model">taskhub.rfq</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'new')]</field>
        <field name="context">{'default_state': 'new'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Inbox zero</p>
            <p>New RFQs wait here until an administrator approves or rejects them.</p>
        </field>
    </record>
</odoo>

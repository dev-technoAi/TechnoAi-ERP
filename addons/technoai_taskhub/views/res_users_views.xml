<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Alert sounds: each user picks the sound and volume of the due alerts -->
    <record id="taskhub_alert_sound_view_form" model="ir.ui.view">
        <field name="name">res.users.taskhub.alert.sound.form</field>
        <field name="model">res.users</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Alert sounds" create="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1>Alert sounds</h1></div>
                    <p class="text-muted">Played when one of your tasks falls due. Your browser may ask to allow sound the first time.</p>
                    <group>
                        <field name="taskhub_alert_sound" widget="radio"/>
                        <field name="taskhub_alert_volume" widget="integer"/>
                    </group>
                    <widget name="taskhub_sound_test"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="taskhub_alert_sound_action" model="ir.actions.server">
        <field name="name">Alert sounds</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Alert sounds',
    'res_model': 'res.users',
    'res_id': env.user.id,
    'view_mode': 'form',
    'views': [(env.ref('technoai_taskhub.taskhub_alert_sound_view_form').id, 'form')],
    'target': 'current',
}</field>
    </record>
</odoo>

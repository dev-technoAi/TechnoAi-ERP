<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_taskhub_quotation" model="mail.template">
            <field name="name">Task Hub: send quotation</field>
            <field name="model_id" ref="model_taskhub_quotation"/>
            <field name="subject">Quotation {{ object.name }}{{ object.rfq_id and ' – ' + object.rfq_id.subject or '' }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id or '' }}</field>
            <field name="email_to">{{ not object.partner_id and object.client_email or '' }}</field>
            <field name="report_template_ids" eval="[Command.link(ref('action_report_taskhub_quotation'))]"/>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0;">
    <p>Dear <t t-out="object.partner_id.name or object.client_name or 'Sir / Madam'"/>,</p>
    <p>Thank you for your request. Please find attached our quotation
        <strong t-out="object.name"/> for a total of
        <strong t-out="format_amount(object.amount_total, object.currency_id)"/>,
        valid until <t t-out="format_date(object.valid_until)"/>.</p>
    <p>Do not hesitate to contact us if you have any questions.</p>
    <p>Best regards,<br/><t t-out="object.user_id.name"/><br/><t t-out="object.company_id.name"/></p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>

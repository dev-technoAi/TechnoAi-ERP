<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="technoai_taskhub.Reports">
        <div class="o_action o_taskhub_reports">
            <div class="o_control_panel d-flex align-items-center gap-2 px-3">
                <button class="btn btn-secondary" t-on-click="exportCsv" t-att-disabled="!state.data"><i class="fa fa-download me-1"/>Export CSV</button>
                <span class="o_taskhub_title ms-1">Reports &amp; Commercial Analytics</span>
                <div class="o_taskhub_tabs ms-auto">
                    <button class="o_taskhub_tab" t-att-class="{ active: state.days === 30 }" t-on-click="() => this.setDays(30)">30 days</button>
                    <button class="o_taskhub_tab" t-att-class="{ active: state.days === 90 }" t-on-click="() => this.setDays(90)">90 days</button>
                </div>
            </div>
            <div class="o_content" t-if="state.data">
                <div class="o_taskhub_report_kpis">
                    <t t-foreach="kpis" t-as="kpi" t-key="kpi_index">
                        <div class="o_taskhub_report_kpi" t-on-click="() => this.open(kpi.open)">
                            <small t-esc="kpi.label"/>
                            <b t-esc="kpi.value"/>
                            <em t-esc="kpi.note"/>
                        </div>
                    </t>
                </div>
                <div class="o_taskhub_report_row">
                    <div class="o_taskhub_report_card flex-grow-1">
                        <div class="d-flex align-items-center mb-2">
                            <b class="fs-6">Won revenue · last <t t-esc="state.days"/> days</b>
                            <span class="ms-auto small text-muted">
                                <span class="o_taskhub_legend o_taskhub_legend_now"/> This period
                                <span class="o_taskhub_legend o_taskhub_legend_prev ms-2"/> Previous period
                            </span>
                        </div>
                        <div class="o_taskhub_bars">
                            <t t-foreach="bars" t-as="bar" t-key="bar_index">
                                <div class="o_taskhub_bar_slot" t-att-title="bar.title">
                                    <i class="o_taskhub_bar_prev" t-attf-style="height: {{ bar.prevHeight }}%"/>
                                    <i class="o_taskhub_bar_now" t-attf-style="height: {{ bar.height }}%"/>
                                </div>
                            </t>
                        </div>
                        <div class="o_taskhub_bar_labels">
                            <t t-foreach="bars" t-as="bar" t-key="bar_index">
                                <span t-esc="bar.showLabel ? bar.label : ''"/>
                            </t>
                        </div>
                    </div>
                    <div class="o_taskhub_report_card o_taskhub_workload">
                        <b class="fs-6">Team workload</b>
                        <div class="small text-muted mb-2">Open tasks per person</div>
                        <t t-foreach="workload" t-as="row" t-key="row.user_id">
                            <div class="o_taskhub_wl" t-on-click="() => this.openUserTasks(row)">
                                <span class="o_taskhub_wl_avatar" t-esc="row.initials"/>
                                <span class="o_taskhub_wl_name"><t t-esc="row.name"/><small t-esc="row.department"/></span>
                                <span class="o_taskhub_wl_bar"><i t-attf-style="width: {{ row.width }}%"/></span>
                                <b t-esc="row.open_tasks"/>
                            </div>
                        </t>
                        <p t-if="!workload.length" class="text-muted">No open tasks.</p>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>

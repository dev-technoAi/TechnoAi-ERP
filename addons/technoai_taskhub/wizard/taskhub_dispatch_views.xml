<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="taskhub_dispatch_view_form" model="ir.ui.view">
        <field name="name">taskhub.dispatch.form</field>
        <field name="model">taskhub.dispatch</field>
        <field name="arch" type="xml">
            <form string="Dispatch task">
                <group>
                    <group>
                        <field name="task_id" readonly="1"/>
                        <field name="user_id"/>
                    </group>
                    <group string="Send by">
                        <field name="via_notification"/>
                        <field name="via_email"/>
                        <field name="email" widget="email" invisible="not via_email" required="via_email"/>
                        <field name="via_whatsapp"/>
                        <field name="phone" widget="phone" invisible="not via_whatsapp" required="via_whatsapp"
                               placeholder="+971 55 000 0000"/>
                    </group>
                </group>
                <field name="message" placeholder="Message"/>
                <div class="text-muted small mt-2" invisible="not via_whatsapp">
                    Without a WhatsApp provider in Task Hub settings, WhatsApp opens with this message ready to send.
                </div>
                <footer>
                    <button name="action_send" string="Dispatch" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

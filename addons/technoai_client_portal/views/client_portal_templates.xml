<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- head shared by every page of the client portal -->
    <template id="head">
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="robots" content="noindex"/>
        <link rel="icon" type="image/png" href="/technoai_portal/static/src/img/favicon.png"/>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600;700&amp;display=swap"/>
        <link rel="stylesheet" href="/web/static/src/libs/fontawesome/css/font-awesome.css"/>
        <link rel="stylesheet" href="/technoai_client_portal/static/src/css/client_portal.css"/>
    </template>

    <template id="login" name="Client portal sign in">
        &lt;!DOCTYPE html&gt;
        <html lang="en">
            <head>
                <t t-call="technoai_client_portal.head"/>
                <title>Sign in - Techno AI Client Portal</title>
            </head>
            <body>
                <div class="cp-login">
                    <div class="cp-login-left">
                        <a href="/landing"><img src="/technoai_backend_theme/static/img/logo-mark-white.png" alt="Techno AI" class="cp-login-logo"/></a>
                        <h1>Techno AI Client Portal</h1>
                        <p>Your quotations, orders, deliveries and invoices with Techno AI, live, in one place.</p>
                        <ul>
                            <li>Accept quotations online</li>
                            <li>Follow every item of your order</li>
                            <li>Download delivery notes and invoices</li>
                            <li>Send us a new request for quotation</li>
                        </ul>
                    </div>
                    <div class="cp-login-right">
                        <form class="cp-box" action="/clientportal/login" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <h2>Sign in</h2>
                            <div class="cp-muted">Techno AI Client Portal</div>
                            <div t-if="error" class="cp-alert" t-out="error"/>
                            <t t-call="technoai_client_portal.staff_notice"/>
                            <label>Email<input type="email" name="login" t-att-value="login" required="required" autocomplete="username" autofocus="autofocus"/></label>
                            <label>Password<input type="password" name="password" required="required" autocomplete="current-password"/></label>
                            <button type="submit" class="cp-btn cp-primary cp-block">Sign in</button>
                            <div class="cp-muted cp-small">
                                <a href="/web/reset_password?redirect=/clientportal/home">Forgot password?</a> ·
                                No account? Ask your Techno AI contact for an invitation.
                            </div>
                            <div class="cp-note">Separate from the staff sign-in: clients only ever see their own company's documents.</div>
                        </form>
                    </div>
                </div>
            </body>
        </html>
    </template>

    <!-- a staff session in this browser: say so on the portal sign-in instead of opening the ERP -->
    <template id="staff_notice">
        <div t-if="staff" class="cp-staff">
            You are signed in as staff (<b t-out="staff.name"/>) in this browser.
            <a t-attf-href="/web/session/logout?redirect={{ portal }}">Sign out</a> to use this portal,
            or <a href="/odoo">open the ERP</a>.
            <div class="cp-muted cp-small">Tip: use a private (incognito) window to test the portal while you stay signed in to the ERP.</div>
        </div>
    </template>

    <template id="layout" name="Client portal layout">
        &lt;!DOCTYPE html&gt;
        <html lang="en">
            <head>
                <t t-call="technoai_client_portal.head"/>
                <title><t t-out="title or 'Client Portal'"/> - Techno AI</title>
            </head>
            <body>
                <header class="cp-top">
                    <a href="/clientportal/home" class="cp-brand"><img src="/technoai_backend_theme/static/img/logo-mark-white.png" alt="Techno AI"/><span>Client Portal</span></a>
                    <nav>
                        <a href="/clientportal/home" t-att-class="active == 'home' and 'on'">Home</a>
                        <a href="/clientportal/quotations" t-att-class="active == 'quotations' and 'on'">Quotations</a>
                        <a href="/clientportal/orders" t-att-class="active == 'orders' and 'on'">Orders</a>
                        <a href="/clientportal/deliveries" t-att-class="active == 'deliveries' and 'on'">Deliveries</a>
                        <a href="/clientportal/invoices" t-att-class="active == 'invoices' and 'on'">Invoices</a>
                        <a href="/clientportal/request" t-att-class="active == 'request' and 'on'">Request a quote</a>
                    </nav>
                    <span class="cp-grow"/>
                    <div class="cp-who">
                        <span class="cp-avatar" t-out="(client.name or '?')[:2].upper()"/>
                        <span><t t-out="client.name"/><br/><small t-out="company_partner.name"/></span>
                        <a href="/web/session/logout?redirect=/clientportal" class="cp-logout" title="Sign out"><i class="fa fa-sign-out"/></a>
                    </div>
                </header>
                <main class="cp-wrap">
                    <t t-out="0"/>
                </main>
                <footer class="cp-foot">Techno AI · Abu Dhabi, UAE · <a href="https://technoai.ae" target="_blank" rel="noopener noreferrer">technoai.ae</a></footer>
            </body>
        </html>
    </template>

    <!-- a figure per currency, never one mixed total -->
    <template id="totals">
        <t t-if="not totals"><t t-out="money(0, company_currency)"/></t>
        <t t-foreach="totals" t-as="total">
            <div class="cp-total"><t t-out="money(total['amount'], total['currency'])"/>
                <small t-if="total['local']" class="cp-muted">≈ <t t-out="money(total['local'], company_currency)"/></small>
            </div>
        </t>
    </template>

    <template id="status_pill">
        <t t-set="labels" t-value="{'processing': 'Processing', 'ready_to_ship': 'Ready to ship', 'in_transit': 'In transit', 'in_inventory': 'In our warehouse', 'ready_for_delivery': 'Ready for delivery', 'delivered': 'Delivered', 'late': 'Delayed', 'closed': 'Delivered'}"/>
        <span t-attf-class="cp-pill s-{{ key }}" t-out="labels.get(key, key)"/>
    </template>

    <template id="home" name="Client portal home">
        <t t-call="technoai_client_portal.layout">
            <t t-set="title" t-value="'Home'"/>
            <h1>Welcome, <t t-out="(client.name or '').split(' ')[0]"/></h1>
            <div class="cp-sub"><t t-out="company_partner.name"/><t t-if="manager"> · your account manager: <t t-out="manager.name"/> (<t t-out="manager.email"/>)</t></div>
            <div class="cp-kpis">
                <a class="cp-kpi" href="/clientportal/quotations"><b t-out="quotation_count"/><span>Quotations waiting for you</span></a>
                <a class="cp-kpi" href="/clientportal/orders"><b t-out="len(open_orders)"/><span>Orders in progress</span></a>
                <a class="cp-kpi" href="/clientportal/orders"><b t-out="items_on_way"/><span>Items on the way</span></a>
                <a class="cp-kpi" href="/clientportal/invoices"><b><t t-call="technoai_client_portal.totals"><t t-set="totals" t-value="to_pay_totals"/></t></b>
                    <span>To pay<t t-if="overdue_count"> (<t t-out="overdue_count"/> overdue)</t></span></a>
            </div>
            <div class="cp-grid2">
                <div>
                    <div class="cp-card">
                        <h3>Quotations waiting for you<a href="/clientportal/quotations">All quotations</a></h3>
                        <table t-if="quotations">
                            <tr><th>Quotation</th><th>Date</th><th>Valid until</th><th class="cp-r">Total</th><th/></tr>
                            <tr t-foreach="quotations" t-as="q">
                                <td><b t-out="q.name"/><t t-if="q.client_order_ref"> · <t t-out="q.client_order_ref"/></t></td>
                                <td t-out="fmt_date(q.date_order)"/>
                                <td t-out="fmt_date(q.validity_date)"/>
                                <td class="cp-r" t-out="money(q.amount_total, q.currency_id)"/>
                                <td class="cp-r"><a class="cp-btn cp-accent" t-attf-href="/clientportal/quotations/{{ q.id }}/review">Review &amp; accept</a></td>
                            </tr>
                        </table>
                        <div t-else="" class="cp-muted">No quotations waiting.</div>
                    </div>
                    <div class="cp-card">
                        <h3>Orders in progress<a href="/clientportal/orders">All orders</a></h3>
                        <t t-call="technoai_client_portal.order_rows"><t t-set="rows" t-value="open_orders[:8]"/></t>
                    </div>
                </div>
                <div>
                    <div class="cp-card">
                        <h3>To pay</h3>
                        <table t-if="to_pay">
                            <tr t-foreach="to_pay[:6]" t-as="inv">
                                <td><t t-out="inv.name"/><br/>
                                    <small t-if="inv.invoice_date_due and inv.invoice_date_due &lt; today" class="cp-bad">overdue <t t-out="(today - inv.invoice_date_due).days"/> days</small>
                                    <small t-else="" class="cp-muted">due <t t-out="fmt_date(inv.invoice_date_due)"/></small></td>
                                <td class="cp-r" t-out="money(inv.amount_residual, inv.currency_id)"/>
                            </tr>
                        </table>
                        <div t-else="" class="cp-muted">Nothing to pay. Thank you!</div>
                        <a class="cp-btn cp-mt" href="/clientportal/statement">Account statement</a>
                    </div>
                    <div class="cp-card">
                        <h3>Need something?</h3>
                        <div class="cp-muted cp-mb">Send us your requirement and the sales team gets it at once.</div>
                        <a class="cp-btn cp-primary" href="/clientportal/request">Request a quote</a>
                    </div>
                    <div class="cp-card">
                        <h3>Latest updates</h3>
                        <div t-foreach="updates" t-as="line" class="cp-update">
                            <small class="cp-muted" t-out="line.last_update and line.last_update.strftime('%d %b')"/> ·
                            <t t-out="line.name"/>: <b t-out="line.public_status"/> <small class="cp-muted">(PO <t t-out="line.order_id.name"/>)</small>
                        </div>
                        <div t-if="not updates" class="cp-muted">No updates yet.</div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="order_rows">
        <table t-if="rows">
            <tr><th>Your PO</th><th>Our order</th><th>Progress</th><th>Next ETA</th><th class="cp-r">Total</th><th>Status</th></tr>
            <tr t-foreach="rows" t-as="o" class="cp-link" t-attf-onclick="location.href='/clientportal/orders/{{ o.id }}'">
                <t t-set="trk" t-value="o.tracking_ids[:1]"/>
                <td><b t-out="o.client_order_ref or '-'"/></td>
                <td><a t-attf-href="/clientportal/orders/{{ o.id }}" t-out="o.name"/></td>
                <td>
                    <t t-if="trk"><div class="cp-bar"><i t-attf-style="width: {{ trk.progress }}%"/></div>
                        <small class="cp-muted"><t t-out="trk.delivered_count"/> of <t t-out="trk.line_count"/> delivered</small></t>
                    <t t-else="">-</t>
                </td>
                <td t-att-class="trk and trk.is_overdue and 'cp-bad'" t-out="trk and fmt_date(trk.next_eta) or '-'"/>
                <td class="cp-r" t-out="money(o.amount_total, o.currency_id)"/>
                <td><t t-if="trk" t-call="technoai_client_portal.status_pill"><t t-set="key" t-value="trk.status_summary"/></t></td>
            </tr>
        </table>
        <div t-else="" class="cp-muted">No orders yet.</div>
    </template>

    <template id="quotations" name="Client portal quotations">
        <t t-call="technoai_client_portal.layout">
            <t t-set="title" t-value="'Quotations'"/>
            <h1>Quotations</h1>
            <div class="cp-sub">Quotations Techno AI sent you. Review one to accept it (and sign, when asked).</div>
            <div class="cp-card">
                <table t-if="quotations">
                    <tr><th>Quotation</th><th>Your reference</th><th>Date</th><th>Valid until</th><th class="cp-r">Total</th><th/></tr>
                    <tr t-foreach="quotations" t-as="q">
                        <td><b t-out="q.name"/></td>
                        <td t-out="q.client_order_ref or '-'"/>
                        <td t-out="fmt_date(q.date_order)"/>
                        <td t-out="fmt_date(q.validity_date)"/>
                        <td class="cp-r" t-out="money(q.amount_total, q.currency_id)"/>
                        <td class="cp-r">
                            <a class="cp-btn" t-attf-href="/clientportal/pdf/order/{{ q.id }}"><i class="fa fa-file-pdf-o"/> PDF</a>
                            <a class="cp-btn cp-accent" t-attf-href="/clientportal/quotations/{{ q.id }}/review">Review &amp; accept</a>
                        </td>
                    </tr>
                </table>
                <div t-else="" class="cp-muted">No quotations waiting for you.</div>
            </div>
        </t>
    </template>

    <template id="orders" name="Client portal orders">
        <t t-call="technoai_client_portal.layout">
            <t t-set="title" t-value="'Orders'"/>
            <h1>Orders</h1>
            <div class="cp-sub">Your confirmed orders, with every item followed until delivery.</div>
            <div class="cp-card"><t t-call="technoai_client_portal.order_rows"><t t-set="rows" t-value="orders"/></t></div>
        </t>
    </template>

    <template id="order" name="Client portal order">
        <t t-call="technoai_client_portal.layout">
            <t t-set="title" t-value="order.client_order_ref or order.name"/>
            <h1>Your PO <t t-out="order.client_order_ref or order.name"/></h1>
            <div class="cp-sub">Our order <t t-out="order.name"/> · ordered <t t-out="fmt_date(order.date_order)"/>
                <t t-if="order.payment_term_id"> · <t t-out="order.payment_term_id.name"/></t>
                <t t-if="tracking and tracking.state == 'open' and tracking.overall_eta"> · expected complete by <t t-out="fmt_date(tracking.overall_eta)"/></t></div>
            <div class="cp-actions">
                <a class="cp-btn" t-attf-href="/clientportal/pdf/order/{{ order.id }}"><i class="fa fa-file-pdf-o"/> Order confirmation</a>
                <a t-foreach="deliveries" t-as="d" class="cp-btn" t-attf-href="/clientportal/pdf/delivery/{{ d.id }}"><i class="fa fa-truck"/> Delivery note <t t-out="d.name"/></a>
                <a t-foreach="invoices" t-as="inv" class="cp-btn" t-attf-href="/clientportal/pdf/invoice/{{ inv.id }}"><i class="fa fa-file-text-o"/> Invoice <t t-out="inv.name"/></a>
                <a t-if="tracking" class="cp-btn" t-att-href="tracking.public_url" target="_blank"><i class="fa fa-map-marker"/> Public tracking page</a>
            </div>
            <div class="cp-card">
                <h3>Items</h3>
                <t t-if="tracking">
                    <div class="cp-bar cp-mb"><i t-attf-style="width: {{ tracking.progress }}%"/></div>
                    <table>
                        <tr><th>Item</th><th>Qty</th><th>Status</th><th>Expected</th><th>Shipment</th></tr>
                        <tr t-foreach="tracking.line_ids" t-as="line">
                            <td t-out="line.name"/>
                            <td><t t-out="'%g' % line.quantity"/> <t t-out="line.uom or ''"/></td>
                            <td><t t-call="technoai_client_portal.status_pill"><t t-set="key" t-value="line.status"/></t></td>
                            <td t-out="line.status != 'delivered' and fmt_date(line.eta) or '-'"/>
                            <td><a t-if="line.shipment_link" t-att-href="line.shipment_link" target="_blank" rel="noopener noreferrer">Track shipment</a><t t-else="">-</t></td>
                        </tr>
                    </table>
                </t>
                <table t-else="">
                    <tr><th>Item</th><th>Qty</th></tr>
                    <tr t-foreach="order.order_line.filtered(lambda l: not l.display_type)" t-as="l"><td t-out="l.name"/><td t-out="'%g' % l.product_uom_qty"/></tr>
                </table>
            </div>
            <div class="cp-grid2">
                <div class="cp-card" id="messages">
                    <h3>Messages</h3>
                    <div t-if="sent" class="cp-ok-msg">Sent. Your Techno AI contact has been told.</div>
                    <div t-foreach="messages" t-as="m" class="cp-msg">
                        <b t-out="m.author_id.name"/> <small class="cp-muted" t-out="m.date.strftime('%d %b %Y %H:%M')"/>
                        <div t-out="m.body"/>
                    </div>
                    <form t-attf-action="/clientportal/orders/{{ order.id }}/message" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <textarea name="message" rows="3" placeholder="Write a message to Techno AI..." required="required"/>
                        <button type="submit" class="cp-btn cp-primary">Send</button>
                    </form>
                </div>
                <div class="cp-card">
                    <h3>Amounts</h3>
                    <table>
                        <tr><td>Untaxed</td><td class="cp-r" t-out="money(order.amount_untaxed, order.currency_id)"/></tr>
                        <tr><td>VAT</td><td class="cp-r" t-out="money(order.amount_tax, order.currency_id)"/></tr>
                        <tr><td><b>Total</b></td><td class="cp-r"><b t-out="money(order.amount_total, order.currency_id)"/></td></tr>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="deliveries" name="Client portal deliveries">
        <t t-call="technoai_client_portal.layout">
            <t t-set="title" t-value="'Deliveries'"/>
            <h1>Deliveries</h1>
            <div class="cp-sub">Delivery notes of your orders.</div>
            <div class="cp-card">
                <table t-if="deliveries">
                    <tr><th>Delivery note</th><th>Order</th><th>Date</th><th>Status</th><th/></tr>
                    <tr t-foreach="deliveries" t-as="d">
                        <td><b t-out="d.name"/></td>
                        <td t-out="d.sale_id.client_order_ref or d.sale_id.name or d.origin or '-'"/>
                        <td t-out="fmt_date(d.date_done or d.scheduled_date)"/>
                        <td><span t-attf-class="cp-pill {{ 's-delivered' if d.state == 'done' else 's-in_transit' }}" t-out="'Delivered' if d.state == 'done' else 'Being prepared'"/></td>
                        <td class="cp-r"><a class="cp-btn" t-attf-href="/clientportal/pdf/delivery/{{ d.id }}"><i class="fa fa-download"/> PDF</a></td>
                    </tr>
                </table>
                <div t-else="" class="cp-muted">No deliveries yet.</div>
            </div>
        </t>
    </template>

    <template id="invoices" name="Client portal invoices">
        <t t-call="technoai_client_portal.layout">
            <t t-set="title" t-value="'Invoices'"/>
            <h1>Invoices</h1>
            <div class="cp-sub">Everything Techno AI invoiced to <t t-out="company_partner.name"/>, each in its own currency.</div>
            <div class="cp-kpis cp-kpis3">
                <div class="cp-kpi"><b><t t-call="technoai_client_portal.totals"><t t-set="totals" t-value="to_pay_totals"/></t></b><span>To pay</span></div>
                <div class="cp-kpi"><b class="cp-bad"><t t-call="technoai_client_portal.totals"><t t-set="totals" t-value="overdue_totals"/></t></b><span>Overdue</span></div>
                <div class="cp-kpi"><b><t t-call="technoai_client_portal.totals"><t t-set="totals" t-value="paid_totals"/></t></b><span>Paid this year</span></div>
            </div>
            <div class="cp-card">
                <h3>All invoices<a href="/clientportal/statement">Account statement</a></h3>
                <table t-if="invoices">
                    <tr><th>Invoice</th><th>Date</th><th>Due</th><th>Your PO</th><th class="cp-r">Amount</th><th class="cp-r">To pay</th><th>Status</th><th/></tr>
                    <tr t-foreach="invoices" t-as="inv">
                        <t t-set="overdue" t-value="inv.payment_state in ('not_paid', 'partial') and inv.invoice_date_due and inv.invoice_date_due &lt; today"/>
                        <td><b t-out="inv.name"/><t t-if="inv.move_type == 'out_refund'"> <small class="cp-muted">(credit note)</small></t></td>
                        <td t-out="fmt_date(inv.invoice_date)"/>
                        <td t-out="fmt_date(inv.invoice_date_due)"/>
                        <td t-out="inv.ref or '-'"/>
                        <td class="cp-r" t-out="money(inv.amount_total, inv.currency_id)"/>
                        <td class="cp-r" t-out="money(inv.amount_residual, inv.currency_id)"/>
                        <td>
                            <span t-if="inv.payment_state in ('paid', 'in_payment', 'reversed')" class="cp-pill s-delivered">Paid</span>
                            <span t-elif="overdue" class="cp-pill s-late">Overdue</span>
                            <span t-elif="inv.payment_state == 'partial'" class="cp-pill s-in_transit">Partly paid</span>
                            <span t-else="" class="cp-pill s-ready_to_ship">To pay</span>
                        </td>
                        <td class="cp-r"><a class="cp-btn" t-attf-href="/clientportal/pdf/invoice/{{ inv.id }}"><i class="fa fa-download"/> PDF</a></td>
                    </tr>
                </table>
                <div t-else="" class="cp-muted">No invoices yet.</div>
            </div>
        </t>
    </template>

    <template id="statement" name="Client portal statement">
        <t t-call="technoai_client_portal.layout">
            <t t-set="title" t-value="'Statement'"/>
            <h1>Account statement</h1>
            <div class="cp-sub"><t t-out="company_partner.name"/> · <t t-out="fmt_date(today)"/>
                <a class="cp-btn cp-noprint" href="#" onclick="window.print(); return false;"><i class="fa fa-print"/> Print or save as PDF</a></div>
            <div class="cp-card">
                <table>
                    <tr><th>Date</th><th>Invoice</th><th>Due</th><th class="cp-r">Amount</th><th class="cp-r">Paid</th><th class="cp-r">Balance</th></tr>
                    <tr t-foreach="invoices" t-as="inv">
                        <t t-set="sign" t-value="-1 if inv.move_type == 'out_refund' else 1"/>
                        <td t-out="fmt_date(inv.invoice_date)"/>
                        <td><t t-out="inv.name"/><t t-if="sign &lt; 0"> (credit note)</t></td>
                        <td t-out="fmt_date(inv.invoice_date_due)"/>
                        <td class="cp-r" t-out="money(sign * inv.amount_total, inv.currency_id)"/>
                        <td class="cp-r" t-out="money(sign * (inv.amount_total - inv.amount_residual), inv.currency_id)"/>
                        <td class="cp-r" t-out="money(sign * inv.amount_residual, inv.currency_id)"/>
                    </tr>
                </table>
                <div class="cp-statement-total"><b>Balance</b> <t t-call="technoai_client_portal.totals"><t t-set="totals" t-value="balance_totals"/></t></div>
            </div>
        </t>
    </template>

    <template id="request" name="Client portal request a quote">
        <t t-call="technoai_client_portal.layout">
            <t t-set="title" t-value="'Request a quote'"/>
            <h1>Request a quote</h1>
            <div class="cp-sub">Tell us what you need. The sales team gets it at once and replies with a quotation.</div>
            <div t-if="done" class="cp-card cp-ok-msg">Thank you. Your request <b t-out="done"/> reached the sales team; you will hear from us soon.</div>
            <form t-else="" class="cp-card cp-form" action="/clientportal/request" method="post" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div t-if="error" class="cp-alert" t-out="error"/>
                <label>What do you need?<input name="subject" maxlength="250" placeholder="e.g. Network switches for the new office" required="required"/></label>
                <label>Items, quantities and details
                    <textarea name="details" rows="8" placeholder="One item per line, e.g.&#10;2 x 24-Port Network Switch&#10;6 x Wireless Access Point&#10;Delivery to Mussafah by 30 Nov"/></label>
                <label>Attachments (BOQ, specifications), up to 15 MB each<input type="file" name="attachments" multiple="multiple"/></label>
                <button type="submit" class="cp-btn cp-primary">Send request</button>
            </form>
        </t>
    </template>
</odoo>

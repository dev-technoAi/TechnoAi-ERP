<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotations list only: an "Upload Excel" button next to New; the Sales Orders list and the form stay as they are -->
    <record id="view_quotation_tree_excel" model="ir.ui.view">
        <field name="name">sale.order.list.quotes.excel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_excel_import" type="object" string="Upload Excel" icon="fa-file-excel-o"
                        display="always" groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Accounting administrators see the full accounting menus of Invoicing -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <!-- Paid apps, menus and screens follow the "Show paid features" setting (hidden by default) -->
    <function model="res.config.settings" name="_technoai_apply_paid_visibility"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.technoai.sales.ext</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- Tax Excl. / Tax Incl. button, for invoices and bills only -->
            <xpath expr="//sheet/notebook" position="before">
                <div class="o_tai_tax_display" invisible="move_type == 'entry'">
                    <field name="tai_tax_display" widget="selection_badge" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">parent.tai_tax_display == 'incl'</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_total']" position="attributes">
                <attribute name="column_invisible">parent.tai_tax_display != 'incl'</attribute>
            </xpath>
        </field>
    </record>
</odoo>

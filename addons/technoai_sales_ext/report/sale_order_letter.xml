<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The company's sale order letter, for quotations, sales orders and pro-formas -->
    <template id="report_saleorder_letter" inherit_id="sale.report_saleorder_document" priority="90">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="partner" t-value="doc.partner_id"/>
            <t t-set="money" t-value="lambda value: '{:,.2f} {}'.format(value, doc.currency_id.name)"/>
            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>

            <div class="header" style="font-family: Lato, Arial, sans-serif;">
                <table style="width: 100%;">
                    <tr>
                        <td style="vertical-align: top; padding: 6px 0 0 8px;">
                            <img t-att-src="doc._tai_letter_logo()" alt="Techno AI" style="width: 82px;"/>
                        </td>
                        <td style="vertical-align: top; width: 250px; border-top: 3px solid #555; text-align: right; font-size: 20px; font-weight: bold; padding-top: 6px;">
                            <t t-if="is_proforma">Pro-Forma Invoice</t>
                            <t t-elif="doc.state in ('draft', 'sent')">Quotation</t>
                            <t t-else="">Sale Order</t>
                        </td>
                    </tr>
                </table>
            </div>

            <div class="article o_report_layout_standard" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id" t-att-data-oe-lang="doc.env.context.get('lang')">
                <style>
                    .tai-letter { font-family: Lato, Arial, sans-serif; font-size: 11.5px; color: #111; }
                    .tai-letter table { width: 100%; border-collapse: collapse; }
                    .tai-letter .tai-lines { margin-top: 12px; }
                    .tai-letter .tai-lines th { background: #e3e3e3; font-weight: bold; padding: 6px 7px; text-align: left; }
                    .tai-letter .tai-lines td { padding: 7px; vertical-align: top; border-bottom: 1px solid #d5d5d5; }
                    .tai-letter .c { text-align: center !important; }
                    .tai-letter .r { text-align: right !important; }
                    .tai-letter .tai-doc td { padding: 7px 4px; border-bottom: 1px solid #d5d5d5; }
                    .tai-letter .tai-band { background: #e3e3e3; font-weight: bold; padding: 5px 2px; }
                    .tai-letter .tai-rule { border-bottom: 1px solid #111; }
                </style>
                <div class="tai-letter">
                    <table>
                        <tr>
                            <td style="width: 52%; vertical-align: top; padding-right: 24px;">
                                <div style="font-size: 14.5px; font-weight: bold; margin: 2px 0 8px;">Customer Details</div>
                                <div style="line-height: 1.48;">
                                    <div t-out="partner.display_name"/>
                                    <div t-if="partner.street" t-out="partner.street"/>
                                    <div t-if="partner.street2" t-out="partner.street2"/>
                                    <div t-if="partner.city" t-out="partner.city"/>
                                    <div t-if="partner.state_id" t-out="partner.state_id.name"/>
                                    <div t-if="partner.country_id" t-out="partner.country_id.name"/>
                                    <div t-if="partner.email">E: <t t-out="partner.email"/></div>
                                    <div t-if="partner.mobile or partner.phone">M: <t t-out="partner.mobile or partner.phone"/></div>
                                    <div t-if="partner.vat">TRN: <t t-out="partner.vat"/></div>
                                </div>
                            </td>
                            <td style="vertical-align: top;">
                                <table class="tai-doc" style="border-top: 1px solid #111;">
                                    <tr><td><b>Doc No:</b></td><td class="r" t-out="doc.name"/></tr>
                                    <tr><td><b>Date:</b></td><td class="r"><span t-field="doc.date_order"/></td></tr>
                                    <tr t-if="doc.validity_date and doc.state in ('draft', 'sent')"><td><b>Valid Until:</b></td><td class="r"><span t-field="doc.validity_date"/></td></tr>
                                    <tr t-if="doc.commitment_date"><td><b>Delivery Date:</b></td><td class="r"><span t-field="doc.commitment_date" t-options="{'widget': 'date'}"/></td></tr>
                                    <tr><td><b>Payment Terms:</b></td><td class="r" t-out="doc.payment_term_id.name or ''"/></tr>
                                    <tr><td><b>Currency:</b></td><td class="r" t-out="doc.currency_id.name"/></tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <table class="tai-lines">
                        <thead><tr>
                            <th class="c" style="width: 34px;">Line</th><th>Description</th><th class="c" style="width: 52px;">Qty.</th>
                            <th class="c" style="width: 84px;">Unit Price</th><th class="c" style="width: 70px;">VAT Rate</th><th class="r" style="width: 108px;">Amount</th>
                        </tr></thead>
                        <tbody>
                            <t t-set="line_no" t-value="0"/>
                            <t t-foreach="doc.order_line" t-as="line">
                                <tr t-if="line.display_type == 'line_section'"><td colspan="6" style="font-weight: bold; background: #f4f4f4;" t-out="line.name"/></tr>
                                <tr t-elif="line.display_type == 'line_note'"><td colspan="6" style="font-style: italic;" t-out="line.name"/></tr>
                                <tr t-else="">
                                    <t t-set="line_no" t-value="line_no + 1"/>
                                    <td class="c" t-out="line_no"/>
                                    <td style="white-space: pre-line;" t-out="line.name"/>
                                    <td class="c" t-out="'{:g}'.format(line.product_uom_qty) if line.product_uom_qty % 1 else '{:.1f}'.format(line.product_uom_qty)"/>
                                    <td class="c">
                                        <t t-out="'{:,.2f}'.format(line.price_unit)"/>
                                        <div t-if="line.discount" style="font-size: 10px;">-<t t-out="'{:g}'.format(line.discount)"/>%</div>
                                    </td>
                                    <td class="c" t-out="'VAT {:g}%'.format(sum(line.tax_id.mapped('amount'))) if line.tax_id else '-'"/>
                                    <td class="r" t-out="money(line.price_subtotal)"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="tai-rule" style="padding: 9px 2px 14px; line-height: 1.55;">
                        Lead Time:<br/>
                        <b>Stock availability is subject to prior sale and may vary at the time of purchase. In case the item is unavailable, the lead time may increase to 6-7 weeks.</b>
                    </div>

                    <table>
                        <tr class="tai-rule"><td style="padding: 12px 2px;"><b>Subtotal:</b></td><td class="r" t-out="money(doc.amount_untaxed)"/></tr>
                        <tr><td style="padding: 10px 2px 3px;"><b>VAT:</b></td><td class="r" t-out="money(doc.amount_tax)"/></tr>
                        <tr><td style="padding: 3px 2px 12px;"><b>Total:</b></td><td class="r" t-out="money(doc.amount_total)"/></tr>
                    </table>
                    <table style="border-top: 1px solid #111; border-bottom: 1px solid #111; font-weight: bold;">
                        <tr>
                            <td style="width: 110px; padding: 12px 2px;">Grand Total:</td>
                            <td style="padding: 12px 2px;" t-out="doc.currency_id.amount_to_text(doc.amount_total)"/>
                            <td class="r" style="width: 120px; padding: 12px 2px;" t-out="money(doc.amount_total)"/>
                        </tr>
                    </table>

                    <div class="tai-band" style="margin-top: 28px;">Terms and Conditions:</div>
                    <table class="tai-rule">
                        <tr>
                            <td style="padding: 8px 2px; width: 33%;"><b>Availability:</b> <t t-out="doc.tai_availability or ''"/></td>
                            <td style="padding: 8px 2px; width: 33%;"><b>Incoterms :</b> <t t-out="doc.incoterm.code or ''"/><t t-if="doc.incoterm_location">-<t t-out="doc.incoterm_location"/></t></td>
                            <td style="padding: 8px 2px;"><b>Warranty:</b> <t t-out="doc.tai_warranty or ''"/></td>
                        </tr>
                    </table>

                    <div class="tai-band" style="margin-top: 14px;">Disclaimer:</div>
                    <div class="tai-rule" style="padding: 8px 2px 10px; line-height: 1.5;">Customer should notify TechnoAI FZE LLC once the payment is made. All financial/fund transfer/Tax charges are to be borne by the customer</div>

                    <p style="margin-top: 18px; font-size: 11px;">This is a computer generated document. No signature is required.</p>
                </div>
            </div>

            <div class="footer" style="font-family: Lato, Arial, sans-serif;">
                <div style="border-top: 1px solid #111; text-align: center; font-size: 13px; line-height: 1.5; padding-top: 4px;">
                    TechnoAI - info@technoai.ae - 02 634 8633<br/>
                    Office #4, M Floor, Building P-2658, Al Zawaya Street, Khalifa City, Abu Dhabi, United Arab Emirates
                    <div style="font-size: 9px; margin-top: 2px;">Page <span class="page"/> of <span class="topage"/></div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Free options these screens need: quotation templates, pricelists, arrival confirmation -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sale_management.group_sale_order_template')), (4, ref('product.group_product_pricelist')), (4, ref('purchase.group_send_reminder'))]"/>
    </record>

    <function model="account.tax" name="_technoai_set_full_names"/>
    <function model="sale.order" name="_technoai_ensure_pricelists"/>

    <!-- The letter uses the standard A4 format again (an earlier version set its own) -->
    <function model="ir.actions.report" name="write" eval="[[ref('sale.action_report_saleorder'), ref('sale.action_report_pro_forma_invoice')], {'paperformat_id': False}]"/>
</odoo>
